# ─── MarketMind Proxy — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.

# Required — your Anthropic API key (starts with sk-ant-)
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# Optional but recommended — enables full pipeline (60-80% cost reduction)
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx

# Optional — enables Google Trends in the Marketing tab
SERPAPI_KEY=xxxxxxxxxxxx

# Port (Railway/Render set this automatically — don't change)
PORT=3000
